# Password required to log into /admin.
ADMIN_PASSWORD=

# Supabase project — Project Settings → API in the Supabase dashboard.
# Used to store uploaded photos (Storage bucket "fotos") and the site's
# content/config and admin credentials (bucket "site-data"). The service
# role key is required (not the anon key) since uploads happen server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
